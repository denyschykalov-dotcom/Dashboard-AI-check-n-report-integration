{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // Somewhere outside the repo root. A composite project has to emit, and with
    // no outDir it dropped a compiled vite.config.js next to the source — which
    // Vite then loaded in preference to vite.config.ts, so edits to the real
    // config did nothing.
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
